# =================================================================
# SmartStock Backend Environment Configuration
# =================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URI)
# Example Local: mongodb://localhost:27017/smartstock
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartstock?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/smartstock

# JWT Authentication Configuration
# Generate a secure 256-bit secret key for production environments
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Client Application URL for CORS Whitelisting
CLIENT_URL=http://localhost:3000

